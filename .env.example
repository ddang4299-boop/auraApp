# Sao chép file này thành .env rồi điền khoá thật. KHÔNG commit file .env.

# Google: Google Cloud Console → APIs & Services → Credentials →
#   Create OAuth client ID → Application type: "Desktop app".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: developers.facebook.com → Create App → Facebook Login →
#   Valid OAuth Redirect URIs: http://localhost:8765/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Cổng loopback nhận kết quả đăng nhập (phải khớp URL đã đăng ký với Facebook).
OAUTH_REDIRECT_PORT=8765
