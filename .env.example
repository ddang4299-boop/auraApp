# Sao chép file này thành .env rồi điền khoá thật. KHÔNG commit file .env.

# Google: Google Cloud Console → APIs & Services → Credentials →
#   Create OAuth client ID → Application type: "Desktop app".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cổng loopback nhận kết quả đăng nhập Google khi chạy trên máy (tuỳ chọn).
OAUTH_REDIRECT_PORT=8765

# Chatbot (tuỳ chọn). Không có key thì chatbot chạy chế độ từ khoá offline.
# Cài thư viện: pip install -r requirements-dev.txt · Kiểm tra key: python -m Chatbot.doctor
# LLM_PROVIDER: gemini | groq | openrouter | openai | anthropic
# LLM_FALLBACK: provider dự phòng khi provider chính lỗi, cách nhau dấu phẩy; "groq:<model>" chọn rõ model
#   vd groq:openai/gpt-oss-20b,gemini (model Groq thứ hai có hạn mức riêng, rồi tới Gemini). Có thể để trống.
LLM_PROVIDER=groq
LLM_FALLBACK=groq:openai/gpt-oss-20b,gemini
# Chờ AI tối đa bao nhiêu giây; quá thì lượt đó dùng chế độ từ khoá offline
LLM_TIMEOUT=5
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=
# Key của tài khoản thứ hai (hạn mức riêng): key 1 hết lượt thì tự chuyển sang key 2. Thêm _3, _4... nếu cần.
GEMINI_API_KEY_2=
GROQ_API_KEY_2=
# OpenRouter: key lấy ở openrouter.ai/keys, luôn bắt đầu bằng sk-or-
OPENROUTER_API_KEY=
# Model OpenRouter (mặc định google/gemma-4-31b-it:free); model miễn phí có đuôi ":free"
OPENROUTER_MODEL=
# OpenAI (ChatGPT API, tính phí theo lượt: cần nạp tín dụng ở platform.openai.com/settings/organization/billing).
# Gói ChatGPT Plus KHÔNG bao gồm API. Có thể đặt tên biến là CHAT_GPT_KEY. Model mặc định gpt-4.1-mini (OPENAI_MODEL).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
