# Sao chép file này thành .env rồi điền khoá thật. KHÔNG commit file .env.

# Google: Google Cloud Console → APIs & Services → Credentials →
#   Create OAuth client ID → Application type: "Desktop app".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: developers.facebook.com → Create App → Facebook Login →
#   Valid OAuth Redirect URIs: http://localhost:8765/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Cổng loopback nhận kết quả đăng nhập (phải khớp URL đã đăng ký với Facebook).
OAUTH_REDIRECT_PORT=8765

# Chatbot (tuỳ chọn). Không có key thì chatbot chạy chế độ từ khoá offline.
# Cài thư viện: pip install -r requirements-dev.txt · Kiểm tra key: python -m Chatbot.doctor
# LLM_PROVIDER: gemini | groq | openrouter | anthropic
# LLM_FALLBACK: provider dự phòng khi provider chính lỗi (có thể để trống)
LLM_PROVIDER=gemini
LLM_FALLBACK=
# Chờ AI tối đa bao nhiêu giây; quá thì lượt đó dùng chế độ từ khoá offline
LLM_TIMEOUT=8
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Bắt buộc nếu dùng openrouter, vd một model có đuôi ":free"
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
